#!/usr/bin/env bash

# shellcheck source=../dotfiles/dotinc/entrypoint.sh
source "${HOME}/.local/shell-include/entrypoint.sh"

NAME="$1"
SOURCE="$2"
START="${3:-0}"
DURATION="${4:-0}"

uvx hf auth login

EXT="${SOURCE##*.}"
EXT="${EXT,,}"

TARGET="/tmp/voice.wav"
TEMP_TARGET="/tmp/voice_temp.wav"
VOICE="/tmp/voice.safetensors"
OUTPUT="/tmp/voice_output.wav"

is_nonnegative_number() {
    [[ "$1" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]]
}

is_nonnegative_number "$START" ||
    _fatal "START must be a non-negative number: $START"

is_nonnegative_number "$DURATION" ||
    _fatal "DURATION must be a non-negative number: $DURATION"

cleanup() {
    rm -f "$TARGET" "$VOICE" "$TEMP_TARGET" "$OUTPUT"
}
trap cleanup EXIT

_log "Converting source to PCM S16LE, 24000 Hz, mono"

ffmpeg -hide_banner -loglevel error -y \
    -i "$SOURCE" \
    -map 0:a:0 \
    -vn \
    -c:a pcm_s16le \
    -ar 24000 \
    -ac 1 \
    "$TARGET" ||
    _fatal "Could not extract audio from: $SOURCE"

trim_args=(trim "$START")
if awk -v duration="$DURATION" 'BEGIN { exit !(duration > 0) }'; then
    trim_args+=("$DURATION")
fi
trim_args+=(
    "silence" "1" "0.05" "0.5%" "reverse"
    "silence" "1" "0.05" "0.5%" "reverse"
    "highpass" "65"
    "sinc" "-11500"
    "gain" "-n" "-3"
)
play "$TARGET" "${trim_args[@]}"

_yesno "Is this OK?"

sox "$TARGET" "$TEMP_TARGET" "${trim_args[@]}"
mv "$TEMP_TARGET" "$TARGET"

pocket-tts export-voice "${TARGET}" "${VOICE}"

_say() {
    pocket-tts generate \
        --text "${1}" \
        --voice "${VOICE}" \
        --output-path "${OUTPUT}"
    play "${OUTPUT}"
}
_say "$(cat assets/voice-test.txt)"

while _yesno "Say more?"; do
    _read "What to say?"
    _say "${REPLY}"
done

_yesno "Use this voice?"

TOKEN="$(ak-auth-provider proxy pockettts)"
curl -H "Authorization: Bearer ${TOKEN}" -F name="${NAME}" -F file=@"${VOICE}" https://tts.d-reis.com/v1/voices
