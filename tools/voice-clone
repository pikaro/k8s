#!/usr/bin/env bash

# shellcheck source=../dotfiles/dotinc/entrypoint.sh
source "${HOME}/.local/shell-include/entrypoint.sh"

NAME="$1"
SOURCE="$2"
START="${3:-0}"
DURATION="${4:-0}"

uvx hf auth login

EXT="${SOURCE##*.}"
EXT="${EXT,,}"

TARGET="/tmp/voice.wav"
TEMP_TARGET="/tmp/voice_temp.wav"
VOICE="/tmp/voice.safetensors"
OUTPUT="/tmp/voice_output.wav"
TTS_LANG="${TTS_LANG:-english}"
TTS_SAMPLE="${TTS_SAMPLE:-${TTS_LANG}}"

is_nonnegative_number() {
    [[ "$1" =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+)$ ]]
}

is_nonnegative_number "$START" ||
    _fatal "START must be a non-negative number: $START"

is_nonnegative_number "$DURATION" ||
    _fatal "DURATION must be a non-negative number: $DURATION"

cleanup() {
    rm -f "$TARGET" "$VOICE" "$TEMP_TARGET" "$OUTPUT"
}
trap cleanup EXIT

get_youtube_id() {
    local url="$1"
    local id

    case "$url" in
    *youtube.com/watch\?*v=*)
        id="${url#*v=}"
        id="${id%%&*}"
        ;;
    *youtu.be/*)
        id="${url#*youtu.be/}"
        id="${id%%\?*}"
        id="${id%%&*}"
        ;;
    *youtube.com/shorts/*)
        id="${url#*youtube.com/shorts/}"
        id="${id%%\?*}"
        id="${id%%/*}"
        ;;
    *youtube.com/embed/*)
        id="${url#*youtube.com/embed/}"
        id="${id%%\?*}"
        id="${id%%/*}"
        ;;
    *)
        return 1
        ;;
    esac

    printf '%s\n' "$id"
}

find_downloaded_audio() {
    local VIDEO_ID="$1"
    find "/tmp/" -mindepth 1 -maxdepth 1 -name "${VIDEO_ID}*"
}

if [[ "${SOURCE}" == *"youtube"* ]]; then
    VIDEO_ID="$(get_youtube_id "${SOURCE}")"
    DOWNLOADED_FILE="$(find_downloaded_audio "${VIDEO_ID}" || true)"
    if [ -z "${DOWNLOADED_FILE}" ]; then
        DOWNLOAD_TARGET="/tmp/${VIDEO_ID}"
        _log "Downloading ${SOURCE} to ${DOWNLOAD_TARGET}"
        yt-dlp -f bestaudio -x "${SOURCE}" -o "${DOWNLOAD_TARGET}"
        SOURCE="$(find_downloaded_audio "${VIDEO_ID}")"
        if [ -z "${SOURCE}" ]; then
            _fatal "Could not find downloaded audio for ${SOURCE}"
        fi
    else
        SOURCE="${DOWNLOADED_FILE}"
    fi
    _log "Found downloaded audio in ${SOURCE}"
fi

_log "Converting source to PCM S16LE, 24000 Hz, mono"

ffmpeg -hide_banner -loglevel error -y \
    -i "$SOURCE" \
    -map 0:a:0 \
    -vn \
    -c:a pcm_s16le \
    -ar 24000 \
    -ac 1 \
    "$TARGET" ||
    _fatal "Could not extract audio from: $SOURCE"

trim_args=(trim "$START")
if awk -v duration="$DURATION" 'BEGIN { exit !(duration > 0) }'; then
    trim_args+=("$DURATION")
fi
trim_args+=(
    # "silence" "1" "0.05" "0.5%" "reverse"
    # "silence" "1" "0.05" "0.5%" "reverse"
    #"gain" "-3"
    "highpass" "65"
    "sinc" "-11500"
)
play "$TARGET" "${trim_args[@]}"

_yesno "Is this OK?"

sox "$TARGET" "$TEMP_TARGET" "${trim_args[@]}"
mv "$TEMP_TARGET" "$TARGET"

pocket-tts export-voice --language "${TTS_LANG}" "${TARGET}" "${VOICE}"

_say() {
    pocket-tts generate \
        --language "${TTS_LANG}" \
        --text "${1}" \
        --voice "${VOICE}" \
        --output-path "${OUTPUT}"
    play "${OUTPUT}"
}
_say "$(cat "assets/voice-test.${TTS_SAMPLE}.txt")"

while _yesno "Say more?"; do
    _read "What to say?"
    _say "${REPLY}"
done

_yesno "Use this voice?"

TOKEN="$(ak-auth-provider proxy pockettts)"
curl -H "Authorization: Bearer ${TOKEN}" -F name="${NAME}" -F file=@"${VOICE}" https://tts.d-reis.com/v1/voices
